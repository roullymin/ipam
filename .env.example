MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=ipam_admin
MYSQL_PASSWORD=change_me_user_password
MYSQL_DATABASE=ipam_system

# Generate this before first production start:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change_me_with_a_random_value_of_at_least_50_characters
DJANGO_DEBUG=False
DJANGO_ENFORCE_SECURE_SETTINGS=True
APP_VERSION=ipam-20260622.2
DJANGO_ALLOWED_HOSTS=127.0.0.1,192.168.1.100
# Optional: set this explicitly if your access origin is fixed.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.100,https://192.168.1.100

# Production security defaults
DJANGO_SECURE_COOKIES=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_TRUST_PROXY_HEADERS=True
DJANGO_HSTS_SECONDS=31536000
SECURITY_BLOCKLIST_ENABLED=True

# Public workflows are token-gated by default.
ALLOW_PERMANENT_RESIDENT_INTAKE=False
PUBLIC_DCIM_OVERVIEW_ENABLED=False
# Required when PUBLIC_DCIM_OVERVIEW_ENABLED=True.
PUBLIC_DCIM_ACCESS_TOKEN=replace_with_a_long_random_token
PUBLIC_DCIM_INCLUDE_SENSITIVE=False
